# 2024 image-conversion prototype. Original absolute paths replaced with placeholders.
#Changing image format
import os
from PIL import Image

def convert_webp_to_jpg(source_directory, target_directory):
    if not os.path.exists(target_directory):
        os.makedirs(target_directory)
    for root, _, files in os.walk(source_directory):
        for file in files:
            if file.endswith('.webp'):
                webp_path = os.path.join(root, file)
                jpg_path = os.path.join(target_directory, os.path.splitext(file)[0] + '.jpg')
                try:
                    image = Image.open(webp_path).convert('RGB')
                    image.save(jpg_path, 'JPEG')
                    print(f"Converted {webp_path} to {jpg_path}")
                except Exception as e:
                    print(f"Failed to convert {webp_path}: {e}")

